{
  "name": "atwread",
  "version": "0.1.0",
  "description": "AtwRead — 本地 PDF 与 Markdown 阅读器",
  "author": "AtwRead",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node tests/app.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "test:packaged": "node tests/packaged.cjs",
    "deploy": "node scripts/deploy.cjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "@electron/asar": "3.4.1",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0"
  }
}
